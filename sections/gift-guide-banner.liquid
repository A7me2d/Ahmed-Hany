{{ 'gift-guide.css' | asset_url | stylesheet_tag }}

{% liquid
  assign top_artwork = 'gift-guide-artwork-top.png' | asset_url
  assign bottom_artwork = 'gift-guide-artwork-bottom.png' | asset_url
  if section.settings.background_image != blank
    assign top_artwork = section.settings.background_image | image_url: width: 2000
  endif
  if section.settings.mobile_background_image != blank
    assign bottom_artwork = section.settings.mobile_background_image | image_url: width: 1200
  endif
%}

<section
  class="gift-guide gift-guide__banner"
  style="--gift-artwork-top: url('{{ top_artwork }}'); --gift-artwork-bottom: url('{{ bottom_artwork }}');"
>
  <div class="gift-guide__artwork gift-guide__artwork--top" aria-hidden="true"></div>
  <div class="gift-guide__artwork gift-guide__artwork--bottom" aria-hidden="true"></div>
  <div class="gift-guide__nav">
    <a class="gift-guide__brand" href="{{ routes.root_url }}">{{ section.settings.brand }}</a>
    <p class="gift-guide__nav-message">{{ section.settings.nav_message }}</p>
    {% if section.settings.nav_link != blank %}
      <a class="gift-guide__button gift-guide__button--sun gift-guide__nav-action" href="{{ section.settings.nav_link }}">
        {{ section.settings.nav_label }} <span class="gift-guide__arrow" aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  <div class="gift-guide__content">
    <div class="gift-guide__copy">
      <h1 class="gift-guide__title">{{ section.settings.title }}</h1>
      <div class="gift-guide__text">{{ section.settings.text }}</div>
      {% if section.settings.button_link != blank %}
        <a class="gift-guide__button" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }} <span class="gift-guide__arrow" aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>
  <p class="gift-guide__strapline">{{ section.settings.strapline }}</p>
</section>

{% schema %}
{
  "name": "Gift guide banner",
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand", "default": "TISSO VISION" },
    { "type": "text", "id": "nav_message", "label": "Top message", "default": "Find the ideal gift for your loved ones." },
    { "type": "text", "id": "nav_label", "label": "Top button label", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "nav_link", "label": "Top button link" },
    { "type": "text", "id": "title", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "button_label", "label": "Main button label", "default": "SHOP NOW" },
    { "type": "url", "id": "button_link", "label": "Main button link" },
    { "type": "text", "id": "strapline", "label": "Bottom strapline", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" },
    { "type": "image_picker", "id": "background_image", "label": "Top background artwork" },
    { "type": "image_picker", "id": "mobile_background_image", "label": "Bottom background artwork" },
    { "type": "range", "id": "artwork_opacity", "label": "Artwork opacity", "min": 0, "max": 100, "step": 5, "default": 70, "unit": "%" }
  ],
  "presets": [{ "name": "Gift guide banner" }]
}
{% endschema %}
